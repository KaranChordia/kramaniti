NEXT_PUBLIC_SUPABASE_URL="https://bpvbnxqtfwrsmrpvcepc.supabase.co"
# Prefer a publishable key for new deployments. The legacy anon key remains a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Kosh is a separate product and Supabase project. Do not reuse the Platform values above.
NEXT_PUBLIC_KOSH_SUPABASE_URL="https://your-kosh-project.supabase.co"
NEXT_PUBLIC_KOSH_SUPABASE_PUBLISHABLE_KEY="your-kosh-supabase-publishable-key"

# Optional for AI-assisted chat. Task decomposition has a local fallback.
GROQ_API_KEY="your-groq-api-key"

# Kosh's public template guide reuses GROQ_API_KEY and GROQ_CHAT_MODEL.
# Optional server-only override; set KOSH_DISCOVERY_AI_ENABLED=false to use catalogue suggestions only.
KOSH_DISCOVERY_MODEL="openai/gpt-oss-120b"
KOSH_DISCOVERY_AI_ENABLED="true"
